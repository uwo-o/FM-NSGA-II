\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Limitación 1: Paisajes Evolutivos Engañosos (Chessboard)}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Resultados Consolidados: Accuracy, F1-Score y Tiempo (ms) por Dataset y Clasificador}}{5}{table.1}\protected@file@percent }
\newlabel{tab:unified}{{1}{5}{Resultados Consolidados: Accuracy, F1-Score y Tiempo (ms) por Dataset y Clasificador}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Muestra representativa de las fronteras topológicas 2D proyectadas. Se observa el comportamiento del algoritmo \textit  {One-vs-Rest} tejiendo iterativamente colectores de Fourier cerrados alrededor de las nubes de puntos de cada clase. Las superficies evaden elegantemente traslapes no-lineales, encapsulando las distribuciones (\textit  {Moons}) sin disrumpir el espacio exterior, una proeza imposible para proyectores lineales convencionales.}}{5}{figure.6}\protected@file@percent }
\newlabel{fig:dataset}{{6}{5}{Muestra representativa de las fronteras topológicas 2D proyectadas. Se observa el comportamiento del algoritmo \textit {One-vs-Rest} tejiendo iterativamente colectores de Fourier cerrados alrededor de las nubes de puntos de cada clase. Las superficies evaden elegantemente traslapes no-lineales, encapsulando las distribuciones (\textit {Moons}) sin disrumpir el espacio exterior, una proeza imposible para proyectores lineales convencionales}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Evolución del frente estocástico de Pareto en el paso terminal de NSGA-II. La curva de no-dominancia ilustra visualmente el postulado de la Navaja de Ockham paramétrica: el algoritmo balancea implacablemente individuos que priorizan una tasa de error mínima (eje X) frente a individuos que reducen el sobreajuste acortando la longitud de arco y descartando armónicos excesivos (eje Y).}}{5}{figure.7}\protected@file@percent }
\newlabel{fig:pareto}{{7}{5}{Evolución del frente estocástico de Pareto en el paso terminal de NSGA-II. La curva de no-dominancia ilustra visualmente el postulado de la Navaja de Ockham paramétrica: el algoritmo balancea implacablemente individuos que priorizan una tasa de error mínima (eje X) frente a individuos que reducen el sobreajuste acortando la longitud de arco y descartando armónicos excesivos (eje Y)}{figure.7}{}}
