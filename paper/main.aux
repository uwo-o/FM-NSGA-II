\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Resultados del benchmark global (Accuracy) en todos los datasets. Se resalta en verde sólido el rendimiento de la variedad propuesta (FM-NSGA-II) contrastado contra una paleta translúcida para los algoritmos deterministas clásicos. La gráfica evidencia la robustez geométrica del colector estocástico frente a distribuciones no lineales, donde algoritmos puramente lineales o hiperplanos simples sufren colapsos drásticos (ej. \textit  {Circles}).}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:benchmark}{{2}{3}{Resultados del benchmark global (Accuracy) en todos los datasets. Se resalta en verde sólido el rendimiento de la variedad propuesta (FM-NSGA-II) contrastado contra una paleta translúcida para los algoritmos deterministas clásicos. La gráfica evidencia la robustez geométrica del colector estocástico frente a distribuciones no lineales, donde algoritmos puramente lineales o hiperplanos simples sufren colapsos drásticos (ej. \textit {Circles})}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Tiempos de ejecución requeridos para la convergencia en escala logarítmica. A pesar de que la dinámica evolpoblacional exige evaluar cientos de variaciones del colector, la inyección matemática del \textit  {caching} de funciones seno/coseno junto al muestreo aleatorio del 30\% del espacio de entrenamiento (\textit  {Mini-Batching}) amortigua el cuello de botella asintótico, estabilizando los tiempos en umbrales tolerables.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:time}{{3}{3}{Tiempos de ejecución requeridos para la convergencia en escala logarítmica. A pesar de que la dinámica evolpoblacional exige evaluar cientos de variaciones del colector, la inyección matemática del \textit {caching} de funciones seno/coseno junto al muestreo aleatorio del 30\% del espacio de entrenamiento (\textit {Mini-Batching}) amortigua el cuello de botella asintótico, estabilizando los tiempos en umbrales tolerables}{figure.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Evaluación Experimental y Límites Teóricos}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Limitación 1: Paisajes Evolutivos Engañosos (Chessboard)}{3}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Limitación 2: La Maldición de Dimensionalidad}{3}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Precisión global (Accuracy) en la batería de pruebas calculada a lo largo de 20 ejecuciones independientes. Se reporta la media y la desviación estándar ($\pm \sigma $) para exponer la naturaleza estocástica del FM-NSGA-II. Se evidencia cómo los modelos lineales colapsan en distribuciones complejas (Circles, Two Moons), mientras que el FM-NSGA-II logra mantener un rendimiento top-tier consistente, salvo frente al ruido extremo de la maldición de la dimensionalidad (Adversarial 52D) donde los Decision Trees toman ventaja por su Feature Selection inherente. El mejor desempeño medio por dataset se resalta en negrita.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:accuracy}{{1}{4}{Precisión global (Accuracy) en la batería de pruebas calculada a lo largo de 20 ejecuciones independientes. Se reporta la media y la desviación estándar ($\pm \sigma $) para exponer la naturaleza estocástica del FM-NSGA-II. Se evidencia cómo los modelos lineales colapsan en distribuciones complejas (Circles, Two Moons), mientras que el FM-NSGA-II logra mantener un rendimiento top-tier consistente, salvo frente al ruido extremo de la maldición de la dimensionalidad (Adversarial 52D) donde los Decision Trees toman ventaja por su Feature Selection inherente. El mejor desempeño medio por dataset se resalta en negrita}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Costo computacional de convergencia y tiempos de entrenamiento empírico (expresados en milisegundos $\pm \sigma $ tras 20 iteraciones). Al tratarse de un algoritmo heurístico poblacional (NSGA-II) que debe evaluar distancias proyectadas ortogonalmente a un colector paramétrico complejo, el FM-NSGA-II expone un orden de complejidad temporal manifiestamente superior frente a los clasificadores deterministas clásicos, logrando viabilidad únicamente a través de paralelismo asíncrono y mini-batching evolutivo.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:time}{{2}{4}{Costo computacional de convergencia y tiempos de entrenamiento empírico (expresados en milisegundos $\pm \sigma $ tras 20 iteraciones). Al tratarse de un algoritmo heurístico poblacional (NSGA-II) que debe evaluar distancias proyectadas ortogonalmente a un colector paramétrico complejo, el FM-NSGA-II expone un orden de complejidad temporal manifiestamente superior frente a los clasificadores deterministas clásicos, logrando viabilidad únicamente a través de paralelismo asíncrono y mini-batching evolutivo}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Muestra representativa de las fronteras topológicas 2D proyectadas. Se observa el comportamiento del algoritmo \textit  {One-vs-Rest} tejiendo iterativamente colectores de Fourier cerrados alrededor de las nubes de puntos de cada clase. Las superficies evaden elegantemente traslapes no-lineales, encapsulando las distribuciones (\textit  {Moons}) sin disrumpir el espacio exterior, una proeza imposible para proyectores lineales convencionales.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:dataset}{{4}{4}{Muestra representativa de las fronteras topológicas 2D proyectadas. Se observa el comportamiento del algoritmo \textit {One-vs-Rest} tejiendo iterativamente colectores de Fourier cerrados alrededor de las nubes de puntos de cada clase. Las superficies evaden elegantemente traslapes no-lineales, encapsulando las distribuciones (\textit {Moons}) sin disrumpir el espacio exterior, una proeza imposible para proyectores lineales convencionales}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Evolución del frente estocástico de Pareto en el paso terminal de NSGA-II. La curva de no-dominancia ilustra visualmente el postulado de la Navaja de Ockham paramétrica: el algoritmo balancea implacablemente individuos que priorizan una tasa de error mínima (eje X) frente a individuos que reducen el sobreajuste acortando la longitud de arco y descartando armónicos excesivos (eje Y).}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:pareto}{{5}{4}{Evolución del frente estocástico de Pareto en el paso terminal de NSGA-II. La curva de no-dominancia ilustra visualmente el postulado de la Navaja de Ockham paramétrica: el algoritmo balancea implacablemente individuos que priorizan una tasa de error mínima (eje X) frente a individuos que reducen el sobreajuste acortando la longitud de arco y descartando armónicos excesivos (eje Y)}{figure.5}{}}
