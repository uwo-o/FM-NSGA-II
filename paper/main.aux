\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Precisión global (Accuracy) (una corrida). Se comparan los tres kernels topológicos evolucionados (FM, AM, GAM) contra baselines clásicos en 9 datasets. El mejor valor por dataset se resalta en negrita. GAM-NSGA-II domina en datos tabulares de alta dimensión (Breast Cancer 30D: 97.35\%), mientras FM-NSGA-II mantiene la ventaja en geometrías no-aditivas (Two Moons, Wine). AM-NSGA-II ofrece la mayor velocidad a costa de precisión en alta dimensión.}}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:accuracy}{{1}{5}{Precisión global (Accuracy) (una corrida). Se comparan los tres kernels topológicos evolucionados (FM, AM, GAM) contra baselines clásicos en 9 datasets. El mejor valor por dataset se resalta en negrita. GAM-NSGA-II domina en datos tabulares de alta dimensión (Breast Cancer 30D: 97.35\%), mientras FM-NSGA-II mantiene la ventaja en geometrías no-aditivas (Two Moons, Wine). AM-NSGA-II ofrece la mayor velocidad a costa de precisión en alta dimensión}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Macro F1-Score (una corrida). Complementa la Tabla~\ref {tab:accuracy} con la métrica F1 para exponer desequilibrios en precisión/recall. GAM-NSGA-II logra F1=0.9682 en Breast Cancer 30D, superando a FM (0.9172) y AM (0.9257).}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:f1}{{2}{5}{Macro F1-Score (una corrida). Complementa la Tabla~\ref {tab:accuracy} con la métrica F1 para exponer desequilibrios en precisión/recall. GAM-NSGA-II logra F1=0.9682 en Breast Cancer 30D, superando a FM (0.9172) y AM (0.9257)}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Benchmark Global (Accuracy). Se contrasta la familia Topológica propuesta frente a los modelos clásicos. MGDA conserva o mejora la tasa de exactitud descubierta originalmente por el costoso NSGA-II.}}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:benchmark}{{5}{5}{Benchmark Global (Accuracy). Se contrasta la familia Topológica propuesta frente a los modelos clásicos. MGDA conserva o mejora la tasa de exactitud descubierta originalmente por el costoso NSGA-II}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Asimetría Computacional. La adopción del algoritmo MGDA para los kernels polinomiales (GAM y Angular) provee una aceleración colosal respecto a su homólogo biológico estocástico.}}{5}{figure.caption.11}\protected@file@percent }
\newlabel{fig:time}{{6}{5}{Asimetría Computacional. La adopción del algoritmo MGDA para los kernels polinomiales (GAM y Angular) provee una aceleración colosal respecto a su homólogo biológico estocástico}{figure.caption.11}{}}
\bibcite{deb2002fast}{1}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Costo computacional de entrenamiento (una corrida) (ms). AM-NSGA-II es el kernel más rápido ($\sim $70\,ms en 2D), FM-NSGA-II es el más costoso en alta dimensión (>57\,000\,ms en 30D), GAM-NSGA-II ofrece un balance intermedio ($\sim $2\,000\,ms en 30D) con mayor precisión que FM en datos tabulares.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:time}{{3}{6}{Costo computacional de entrenamiento (una corrida) (ms). AM-NSGA-II es el kernel más rápido ($\sim $70\,ms en 2D), FM-NSGA-II es el más costoso en alta dimensión (>57\,000\,ms en 30D), GAM-NSGA-II ofrece un balance intermedio ($\sim $2\,000\,ms en 30D) con mayor precisión que FM en datos tabulares}{table.caption.8}{}}
